# large run outputs stay local; layouts and the report are tracked
results/*
!results/layouts/
!results/REPORT.md
!results/figures/
__pycache__/
.pytest_cache/
# keep each run's small text outputs (config, summary, report, per-seed trial results)
!results/runs/
results/runs/*/*
!results/runs/*/config.yaml
!results/runs/*/summary.csv
!results/runs/*/summary.json
!results/runs/*/report.md
!results/runs/*/seed*.pkl
# PID tuning outputs are small text files: keep them
!results/pid/
# RL runs: keep the final model, normalisation stats, config, curriculum log and evaluation
!results/rl/
results/rl/*/*
!results/rl/*/model.zip
!results/rl/*/vecnormalize.pkl
!results/rl/*/config.yaml
!results/rl/*/curriculum.json
!results/rl/*/eval/
